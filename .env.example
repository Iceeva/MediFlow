# --- Database (managed PostgreSQL, e.g. Neon, Supabase, Vercel Postgres) ---
# Pooled connection string (pgbouncer / serverless pooler) used at runtime
DATABASE_URL=
# Direct connection string used only by Prisma Migrate
DIRECT_URL=

# --- Auth ---
# 32+ random bytes, e.g. `openssl rand -base64 48`
# Also used (via HKDF) to encrypt documents stored in Vercel Blob. Changing it makes old blobs unreadable.
AUTH_SECRET=

# --- Storage: blob | s3 ---
STORAGE_PROVIDER=blob
BLOB_READ_WRITE_TOKEN=
# Only for STORAGE_PROVIDER=s3 (AWS S3 or Cloudflare R2)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Email (Resend) ---
EMAIL_API_KEY=
EMAIL_FROM="MediFlow <no-reply@example.com>"

# --- Payments (Stripe) ---
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# --- Cron (Vercel sends this as a Bearer token) ---
CRON_SECRET=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
