{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "prisma generate && prisma migrate deploy && next build",
  "crons": [
    { "path": "/api/v1/notifications/cron", "schedule": "0 7 * * *" }
  ],
  "functions": {
    "app/api/**/*.ts": { "maxDuration": 30 }
  }
}
