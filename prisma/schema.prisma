// MediFlow data model. All business tables carry tenantId (a tenant is a healthcare facility).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Enums ----------

enum Role {
  SUPER_ADMIN
  CLINIC_ADMIN
  DOCTOR
  NURSE
  RECEPTIONIST
  ACCOUNTANT
  PATIENT
}

enum Gender {
  FEMALE
  MALE
  OTHER
  UNDISCLOSED
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum DoctorStatus {
  ACTIVE
  ON_LEAVE
  INACTIVE
}

enum MedicationStatus {
  ACTIVE
  DISCONTINUED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum DocumentType {
  PDF
  IMAGE
  SCAN
  LAB_RESULT
  MEDICAL_REPORT
  PRESCRIPTION
  INVOICE
  OTHER
}

enum DocumentAccess {
  STAFF_ONLY
  PATIENT_VISIBLE
}

enum InvoiceStatus {
  DRAFT
  PENDING
  PARTIALLY_PAID
  PAID
  CANCELLED
  OVERDUE
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  MOBILE_MONEY
  INSURANCE
}

enum NotificationType {
  APPOINTMENT_CREATED
  APPOINTMENT_UPDATED
  APPOINTMENT_REMINDER
  PRESCRIPTION_ISSUED
  DOCUMENT_ADDED
  INVOICE_ISSUED
  PAYMENT_RECEIVED
  SYSTEM
}

enum TokenPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
}

enum AuditResult {
  SUCCESS
  DENIED
  FAILURE
}

// ---------- Identity and tenancy ----------

model Tenant {
  id        String       @id @default(uuid()) @db.Uuid
  name      String
  slug      String       @unique
  email     String?
  phone     String?
  address   String?
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?

  memberships   Membership[]
  patients      Patient[]
  doctors       Doctor[]
  staff         StaffProfile[]
  appointments  Appointment[]
  consultations Consultation[]
  vitals        Vital[]
  medications   Medication[]
  prescriptions Prescription[]
  documents     MedicalDocument[]
  invoices      Invoice[]
  payments      Payment[]
  notifications Notification[]
  auditLogs     AuditLog[]
  accessGrants  PatientAccess[]
  counters      SequenceCounter[]
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  passwordHash    String
  firstName       String
  lastName        String
  phone           String?
  isSuperAdmin    Boolean   @default(false)
  emailVerifiedAt DateTime?
  disabledAt      DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  memberships   Membership[]
  sessions      Session[]
  tokens        VerificationToken[]
  doctor        Doctor?
  staffProfile  StaffProfile?
  patient       Patient?
  notifications Notification[]
  auditLogs     AuditLog[]
}

// Role of a user inside one tenant. A user can belong to several tenants.
model Membership {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tenantId  String   @db.Uuid
  role      Role
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId, role])
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tenantId   String?   @db.Uuid
  tokenHash  String    @unique
  ip         String?
  userAgent  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model VerificationToken {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @db.Uuid
  purpose   TokenPurpose
  tokenHash String       @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

// Fixed-window rate limiting stored in PostgreSQL (no Redis).
model RateLimit {
  key       String   @id
  count     Int
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

// Per-tenant human-readable sequences (invoice numbers, prescription numbers).
model SequenceCounter {
  tenantId String @db.Uuid
  name     String
  value    Int    @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, name])
}

// ---------- Clinical ----------

model Patient {
  id                    String    @id @default(uuid()) @db.Uuid
  tenantId              String    @db.Uuid
  userId                String?   @unique @db.Uuid
  firstName             String
  lastName              String
  dateOfBirth           DateTime  @db.Date
  gender                Gender    @default(UNDISCLOSED)
  phone                 String?
  email                 String?
  address               String?
  emergencyContactName  String?
  emergencyContactPhone String?
  bloodType             String?
  allergies             String[]  @default([])
  medicalHistory        String?   @db.Text
  currentMedications    String?   @db.Text
  insuranceProvider     String?
  insuranceNumber       String?
  archivedAt            DateTime?
  deletedAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user          User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  appointments  Appointment[]
  consultations Consultation[]
  vitals        Vital[]
  prescriptions Prescription[]
  documents     MedicalDocument[]
  invoices      Invoice[]
  accessGrants  PatientAccess[]

  @@index([tenantId, lastName, firstName])
  @@index([tenantId, email])
  @@index([tenantId, createdAt])
  @@index([tenantId, deletedAt, archivedAt])
}

// Explicit grant that lets a clinical user (doctor, nurse) see a patient record.
model PatientAccess {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  patientId String   @db.Uuid
  userId    String   @db.Uuid
  grantedBy String   @db.Uuid
  createdAt DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([patientId, userId])
  @@index([tenantId, userId])
}

model Doctor {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @db.Uuid
  userId         String       @unique @db.Uuid
  specialization String
  licenseNumber  String
  phone          String?
  consultationFee Decimal     @default(0) @db.Decimal(12, 2)
  status         DoctorStatus @default(ACTIVE)
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  availability  DoctorAvailability[]
  appointments  Appointment[]
  consultations Consultation[]
  prescriptions Prescription[]

  @@unique([tenantId, licenseNumber])
  @@index([tenantId, specialization])
  @@index([tenantId, status])
}

model DoctorAvailability {
  id        String @id @default(uuid()) @db.Uuid
  doctorId  String @db.Uuid
  dayOfWeek Int // 0 = Sunday ... 6 = Saturday
  startTime String // "HH:mm"
  endTime   String // "HH:mm"

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, dayOfWeek])
}

model StaffProfile {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @db.Uuid
  userId     String    @unique @db.Uuid
  jobTitle   String?
  department String?
  phone      String?
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Appointment {
  id          String            @id @default(uuid()) @db.Uuid
  tenantId    String            @db.Uuid
  patientId   String            @db.Uuid
  doctorId    String            @db.Uuid
  startsAt    DateTime
  endsAt      DateTime
  reason      String?
  notes       String?           @db.Text
  status      AppointmentStatus @default(PENDING)
  createdById String            @db.Uuid
  cancelledAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient      Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor       Doctor        @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  consultation Consultation?

  @@index([tenantId, startsAt])
  @@index([tenantId, doctorId, startsAt, endsAt])
  @@index([tenantId, patientId, startsAt])
  @@index([tenantId, status])
}

model Consultation {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @db.Uuid
  appointmentId String    @unique @db.Uuid
  patientId     String    @db.Uuid
  doctorId      String    @db.Uuid
  symptoms      String?   @db.Text
  diagnosis     String?   @db.Text
  observations  String?   @db.Text
  treatment     String?   @db.Text
  notes         String?   @db.Text
  followUpAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointment   Appointment    @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor        Doctor         @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  vitals        Vital[]
  prescriptions Prescription[]

  @@index([tenantId, patientId, createdAt])
  @@index([tenantId, doctorId, createdAt])
}

model Vital {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @db.Uuid
  patientId        String   @db.Uuid
  consultationId   String?  @db.Uuid
  recordedById     String   @db.Uuid
  systolic         Int?
  diastolic        Int?
  heartRate        Int?
  temperatureC     Decimal? @db.Decimal(4, 1)
  weightKg         Decimal? @db.Decimal(5, 1)
  heightCm         Decimal? @db.Decimal(5, 1)
  oxygenSaturation Int?
  recordedAt       DateTime @default(now())

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient      Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  consultation Consultation? @relation(fields: [consultationId], references: [id], onDelete: SetNull)

  @@index([tenantId, patientId, recordedAt])
}

model Medication {
  id           String           @id @default(uuid()) @db.Uuid
  tenantId     String           @db.Uuid
  name         String
  genericName  String?
  dosageForm   String?
  strength     String?
  manufacturer String?
  status       MedicationStatus @default(ACTIVE)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  tenant Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items  PrescriptionItem[]

  @@index([tenantId, name])
  @@index([tenantId, genericName])
  @@index([tenantId, status])
}

model Prescription {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  number         String
  patientId      String   @db.Uuid
  doctorId       String   @db.Uuid
  consultationId String?  @db.Uuid
  notes          String?  @db.Text
  issuedAt       DateTime @default(now())
  createdAt      DateTime @default(now())

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient      Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor       Doctor             @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  consultation Consultation?      @relation(fields: [consultationId], references: [id], onDelete: SetNull)
  items        PrescriptionItem[]

  @@unique([tenantId, number])
  @@index([tenantId, patientId, issuedAt])
  @@index([tenantId, doctorId, issuedAt])
}

model PrescriptionItem {
  id             String  @id @default(uuid()) @db.Uuid
  prescriptionId String  @db.Uuid
  medicationId   String? @db.Uuid
  medicationName String
  dosage         String
  frequency      String
  duration       String
  route          String?
  instructions   String? @db.Text

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medication   Medication?  @relation(fields: [medicationId], references: [id], onDelete: SetNull)

  @@index([prescriptionId])
}

model MedicalDocument {
  id              String         @id @default(uuid()) @db.Uuid
  tenantId        String         @db.Uuid
  patientId       String         @db.Uuid
  type            DocumentType   @default(OTHER)
  fileName        String
  storageKey      String         @unique
  storageProvider String
  mimeType        String
  size            Int
  accessPolicy    DocumentAccess @default(STAFF_ONLY)
  uploadedById    String         @db.Uuid
  deletedAt       DateTime?
  createdAt       DateTime       @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([tenantId, patientId, createdAt])
  @@index([tenantId, type])
}

// ---------- Billing ----------

model Invoice {
  id          String        @id @default(uuid()) @db.Uuid
  tenantId    String        @db.Uuid
  number      String
  patientId   String        @db.Uuid
  status      InvoiceStatus @default(DRAFT)
  subtotal    Decimal       @default(0) @db.Decimal(12, 2)
  discount    Decimal       @default(0) @db.Decimal(12, 2)
  tax         Decimal       @default(0) @db.Decimal(12, 2)
  total       Decimal       @default(0) @db.Decimal(12, 2)
  amountPaid  Decimal       @default(0) @db.Decimal(12, 2)
  currency    String        @default("XOF")
  dueDate     DateTime?
  notes       String?       @db.Text
  createdById String        @db.Uuid
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient  Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  items    InvoiceItem[]
  payments Payment[]

  @@unique([tenantId, number])
  @@index([tenantId, patientId])
  @@index([tenantId, status, dueDate])
  @@index([tenantId, createdAt])
}

model InvoiceItem {
  id          String  @id @default(uuid()) @db.Uuid
  invoiceId   String  @db.Uuid
  description String
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  tenantId          String        @db.Uuid
  invoiceId         String        @db.Uuid
  amount            Decimal       @db.Decimal(12, 2)
  method            PaymentMethod
  provider          String        @default("manual")
  providerReference String?
  idempotencyKey    String        @unique
  status            PaymentStatus @default(PENDING)
  createdById       String?       @db.Uuid
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId, invoiceId])
  @@index([tenantId, status, createdAt])
  @@index([provider, providerReference])
}

// Processed provider webhook events, for idempotent webhook handling.
model WebhookEvent {
  id        String   @id @default(uuid()) @db.Uuid
  provider  String
  eventId   String
  createdAt DateTime @default(now())

  @@unique([provider, eventId])
}

// ---------- Notifications and audit ----------

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  tenantId  String           @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, read, createdAt])
}

// Append-only. The API exposes no update or delete path for this table.
model AuditLog {
  id         String      @id @default(uuid()) @db.Uuid
  tenantId   String?     @db.Uuid
  userId     String?     @db.Uuid
  action     String
  resource   String
  resourceId String?
  result     AuditResult @default(SUCCESS)
  ip         String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime    @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, userId, createdAt])
  @@index([tenantId, resource, resourceId])
}
